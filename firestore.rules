rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ต้องตรงกับ adminEmail ใน firebase-config.js
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@campset.app';
    }
    // อ่านได้: ทุกคนที่ล็อกอินแล้ว (พนักงานขาย + ผู้ดูแล) / เขียนได้: ผู้ดูแลเท่านั้น
    match /campset/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /campset_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
